# EstateIQ Environment Configuration
# Copy this file to .env and configure your environment variables

# Database
DATABASE_URL=jdbc:postgresql://postgres:5432/estateiq_db
DATABASE_USERNAME=estateiq
DATABASE_PASSWORD=estateiq_password

# Keycloak
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/estateiq
KEYCLOAK_CLIENT_ID=estateiq-backend
KEYCLOAK_CLIENT_SECRET=change_me

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Service URLs (for Gateway)
AUTH_SERVICE_URL=http://auth-service:8081
PROPERTY_SERVICE_URL=http://property-service:8082
SEARCH_SERVICE_URL=http://search-service:8083

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
